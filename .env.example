# Salin ke `.env` (berkas itu diabaikan git) dan isi. Berkas `.env` DIBUNDEL ke aplikasi lewat `assets:` di
# pubspec.yaml, jadi semua yang ada di sini bisa diekstrak dari APK atau IPA. Hanya isi nilai yang aman publik.
# JANGAN pernah mengisi kunci bernilai uang atau kunci service-role di sini.

# ── Supabase (Dashboard > Settings > API) ─────────────────────────────────────
# Kunci anon adalah kunci publik; RLS yang menegakkan akses.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Mindra Web (Teman cerita) ─────────────────────────────────────────────────
# Alamat web yang sudah dideploy, tanpa garis miring di akhir. Kosong = Teman cerita nonaktif di aplikasi.
# Kunci Anthropic hanya ada di server web (variabel lingkungan Vercel), tidak pernah di aplikasi.
WEB_API_BASE_URL=

# ── Integrasi native (belum tersambung) ───────────────────────────────────────
AGORA_APP_ID=
GOOGLE_MAPS_API_KEY=
SATUSEHAT_BASE_URL=https://api-satusehat.kemkes.go.id
SATUSEHAT_CLIENT_ID=
