# Salin menjadi .env.local lalu isi. JANGAN commit .env.local.
# Awalan NEXT_PUBLIC_ = terlihat di browser (aman: akses data dijaga RLS). Selebihnya = rahasia server.

# --- Supabase (Settings > API) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alamat situs ini; dipakai pada tautan di email (konfirmasi daftar, pemulihan sandi).
# Lokal: http://localhost:3000 | Produksi: https://domain-kamu.vercel.app
# Daftarkan juga <alamat>/auth/callback di Supabase > Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RAHASIA - hanya server. Dipakai oleh `pnpm seed` dan kode di lib/server. Jangan beri awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Untuk `pnpm db:types` (ref proyek, mis. abcdefghijklmnop). Tidak rahasia.
SUPABASE_PROJECT_ID=

# --- Katalog komponen (/dev/ui, /dev/shell) ------------------------------------
# Aktif otomatis saat pengembangan. Di produksi 404 kecuali diisi true.
ENABLE_DEV_PAGES=

# --- MFA psikolog (Fase 2) -----------------------------------------------------
# Psikolog WAJIB memakai TOTP. Hanya nilai persis "off" yang melonggarkan gerbang di aplikasi web;
# nilai lain (kosong, salah ketik) tetap mewajibkan. Ini hanya lapisan UX: database tetap menolak data
# klien untuk sesi tanpa TOTP kecuali `alter database postgres set app.psychologist_mfa = 'off'`
# juga dijalankan. Keduanya HANYA untuk demo juri atau uji e2e; jangan dimatikan di produksi nyata.
MFA_ENFORCEMENT=

# --- API publik (Fase 3) ------------------------------------------------------
# Pembatas laju. Kosong = memakai memori proses (cukup untuk pengembangan; di produksi serverless TIDAK dibagi
# antar instans, jadi batasnya hanya kasar). Isi keduanya di produksi (Upstash Redis, gratis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=     # rahasia

# SATUSEHAT. mock (bawaan) = simulasi LOKAL, tidak ada data yang keluar dari server. Mode staging butuh kelima
# nilai di bawah (kredensial sandbox dari Kemenkes); nilai mode yang salah ketik ditolak.
SATUSEHAT_MODE=mock           # mock | staging
SATUSEHAT_AUTH_URL=
SATUSEHAT_BASE_URL=
SATUSEHAT_ORG_ID=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=      # rahasia

# --- Teman cerita (Fase 4) ------------------------------------------------------
# Kunci Anthropic, SERVER SAJA (tanpa awalan NEXT_PUBLIC_). Kosong = Teman cerita nonaktif; jalur krisis
# (balasan tetap, tanpa model) tetap bekerja. JANGAN memakai kunci yang dibundel di aplikasi mobile (temuan F7).
ANTHROPIC_API_KEY=            # rahasia
ANTHROPIC_MODEL=              # kosong = claude-sonnet-5-5

# --- Fase berikutnya (belum dipakai) ---------------------------------
# TURNSTILE_SECRET_KEY=         # rahasia
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
